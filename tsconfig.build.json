{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "declarationDir": "lib/types",
    "noEmit": false,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["tests"]
}
