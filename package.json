{
  "name": "dsh-engineering-control-plane",
  "version": "0.1.3",
  "private": false,
  "license": "MIT",
  "description": "Evidence-backed engineering Mission governance for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-control-plane": "./lib/bin.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./assurance-provider": {
      "types": "./lib/types/assurance-provider.d.ts",
      "default": "./lib/assurance-provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src tests --deny-warnings",
    "prepack": "pnpm build",
    "pack:dry-run": "npm --cache .scratch/npm-cache pack --dry-run",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm pack:dry-run",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness-latest/vendor/cordis",
    "@deepseek-ai/cordis-plugin-loader": "link:../deepseek-harness-latest/vendor/loader",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness-latest/packages/core/agent",
    "@deepseek-ai/dsh-home-paths": "link:../deepseek-harness-latest/packages/util/home-paths",
    "@deepseek-ai/dsh-invariants": "link:../deepseek-harness-latest/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-subagent": "link:../deepseek-harness-latest/packages/subagent/subagent",
    "@deepseek-ai/dsh-subprocess": "link:../deepseek-harness-latest/packages/subprocess/subprocess",
    "@deepseek-ai/dsh-subprocess-local": "link:../deepseek-harness-latest/packages/subprocess/subprocess-local",
    "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness-latest/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness-latest/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../deepseek-harness-latest/vendor/schemastery",
    "@types/node": "link:../deepseek-harness-latest/node_modules/@types/node",
    "oxlint": "link:../deepseek-harness-latest/node_modules/oxlint",
    "typescript": "link:../deepseek-harness-latest/node_modules/typescript",
    "vitest": "link:../deepseek-harness-latest/node_modules/vitest"
  }
}
